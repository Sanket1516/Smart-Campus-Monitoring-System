# ──────────────────────────────────────────────
# Smart Campus Entry Monitor - Backend ENV
# ──────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/smart_campus

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email (Nodemailer - Amazon SES or Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Your Campus Name <noreply@yourcampus.edu>"

# SMS (Fast2SMS - India)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Legacy template key (AES-256-CBC on Student.fingerprintTemplate). Only needed to read
# old templates and for scripts/migrate-templates.js. There is no default.
FP_SECRET=your_fingerprint_encryption_secret_key_here

# Template encryption at rest (AES-256-GCM). REQUIRED: the server will not start without it.
# 32 bytes as 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BIOMETRIC_KEY=

# ADMS push (/iclock). Terminal VLAN ranges allowed to reach it; empty = loopback only.
ADMS_ALLOWED_CIDRS=
# Plain HTTP unless the X990 is proven to support TLS (see HARDWARE_VERIFICATION.md).
ADMS_HTTPS_ENABLED=false
ADMS_DEVICE_UTC_OFFSET=+05:30
# Leave empty to auto-detect per terminal; set to classic or v3 after the pilot.
ADMS_DIALECT_OVERRIDE=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Enrollment Terminal IP (eSSL X990 in admin office)
ENROLLMENT_TERMINAL_IP=192.168.1.50

# AI classifier (Ollama / Gemma)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma:2b
AI_TIMEOUT_MS=5000

# ──────────────────────────────────────────────
# DEPRECATED - Now stored in SystemConfig
# ──────────────────────────────────────────────
# CURFEW_HOUR is now managed via Settings UI
# All notification toggles are in SystemConfig
# College branding is in SystemConfig
# ──────────────────────────────────────────────
