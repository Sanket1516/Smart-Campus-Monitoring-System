# ──────────────────────────────────────────────
# Smart Campus Entry Monitor - Backend ENV
# ──────────────────────────────────────────────

PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/smart_campus

# JWT
# REQUIRED, at least 32 characters. The server refuses to start without it.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Email (Nodemailer - Amazon SES or Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Your Campus Name <noreply@yourcampus.edu>"

# SMS (Fast2SMS - India)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Fingerprint template encryption (AES-256-GCM). REQUIRED. 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it outside the database and back it up separately: losing it loses all templates.
TEMPLATE_ENC_KEY=

# Legacy only (LEGACY_ZK_DIRECT_SYNC=true or scripts/migrateLegacyTemplates.js)
# FP_SECRET=
# LEGACY_ZK_DIRECT_SYNC=false

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Enrollment Terminal IP (eSSL X990 in admin office)
ENROLLMENT_TERMINAL_IP=192.168.1.50

# AI classifier (Ollama / Gemma)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma:2b
AI_TIMEOUT_MS=5000

# ──────────────────────────────────────────────
# DEPRECATED - Now stored in SystemConfig
# ──────────────────────────────────────────────
# CURFEW_HOUR is now managed via Settings UI
# All notification toggles are in SystemConfig
# College branding is in SystemConfig
# ──────────────────────────────────────────────

# ──────────────────────────────────────────────
# Terminal sync (ADMS push) — see README "Terminal sync" and HARDWARE_VERIFICATION.md
# ──────────────────────────────────────────────
# Separate listener for /iclock (recommended). Bind ADMS_HOST to the terminal VLAN address.
ADMS_PORT=8081
ADMS_HOST=0.0.0.0
# REQUIRED in production: terminal IP ranges allowed to call /iclock
ADMS_ALLOWED_CIDRS=10.20.0.0/16
# Optional HTTPS for push (UNVERIFIED on X990). Without TLS keep /iclock on the VLAN only.
ADMS_TLS_KEY=
ADMS_TLS_CERT=
ADMS_RATE_LIMIT_PER_MIN=120
# UNVERIFIED items (pilot will decide):
ADMS_MAX_COMMANDS_PER_POLL=1
ADMS_STRICT_ORDER=true
ADMS_TEMPLATE_SIZE_MODE=bytes
ADMS_EMPTY_FIELD_MODE=omit
ADMS_FORCE_DIALECT=
ADMS_PROBE_ON_HANDSHAKE=true
ADMS_PROBE_PIN=999999999
ADMS_DELETE_MISSING_CODES=-1
ADMS_DEVICE_UTC_OFFSET_MIN=330
ADMS_HANDSHAKE_TIMEZONE=5.5
ADMS_REALTIME_WINDOW_SEC=300
ADMS_OPTION_OVERRIDES=
ADMS_V3_USER_TABLE=user
ADMS_V3_BIODATA_TABLE=biodata
# Pilot evidence log (JSONL); leave empty in production
ADMS_PILOT_LOG=

# Queue
SYNC_ACK_TIMEOUT_MIN=10
SYNC_MAX_ATTEMPTS=3
SYNC_DELETE_SCOPE=all
SYNC_DEFAULT_STUDENT_GROUPS=gate
SYNC_BULK_THRESHOLD=50
SYNC_BULK_DELAY_MS=250
ACCEPT_TEMPLATES_FROM=enrollment
ERASE_ON_DEACTIVATE=true
SCAN_RESOLVE_GLOBAL_PIN=true

# Enrolment: menu (default) | pyzk_remote | push_remote
ENROLL_METHOD=menu
ENROLL_PYZK_REMOTE_ENABLED=false
ENROLL_PUSH_REMOTE_ENABLED=false
ENROLL_REQUIRE_CONSENT=true
ENROLL_DEFAULT_FINGER=0

# Python sidecar (pyzk). Only the sidecar host may reach terminal port 4370.
SIDECAR_URL=http://127.0.0.1:8770
SIDECAR_SECRET=
SIDECAR_TIMEOUT_MS=60000
SIDECAR_CONCURRENCY=2

# Nightly reconciliation: sidecar | push | state
RECONCILE_ENABLED=true
RECONCILE_CRON=20 2 * * *
RECONCILE_TZ=Asia/Kolkata
RECONCILE_SOURCE=sidecar
RECONCILE_DELETE_UNKNOWN=false

# ──────────────────────────────────────────────
# Three-device architecture (see docs/THREE_DEVICE_SETUP.md)
# ──────────────────────────────────────────────
# Roles that may exist only once (real and simulated terminals counted separately)
UNIQUE_DEVICE_ROLES=ADMIN_ENROLLMENT,GATE_ENTRY,GATE_EXIT
# Same student + same direction within this window = duplicate punch
ATTENDANCE_DEDUPE_SECONDS=60
# Enrolment session expires if no template arrives within this time
ENROLL_TIMEOUT_MIN=10
# FULLY_SYNCHRONIZED requires read-back; keep false unless the pilot proves read-back impossible
SYNC_ACK_COUNTS_AS_VERIFIED=false
SYNC_PUSH_READBACK=true
SYNC_SIDECAR_READBACK=true
# Pull-mode terminals (communicationProtocol=zk_tcp_pull) poll interval
PULL_POLL_SECONDS=30
# Capability overrides after the pilot, e.g. {"template_readback_push":"unsupported","menu_enrollment":"verified"}
HARDWARE_CAPABILITIES=
# Development without hardware only. Refused when NODE_ENV=production.
SIMULATION_MODE=false
SIDECAR_FAKE=false

# Gemini (chatbot intent + smart form filling). Same REST API as the Smart Form project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Parent email content (all optional; anything unset is simply left out of the email)
ADMIN_CONTACT_PHONE=
SUPPORT_EMAIL=
PARENT_PORTAL_URL=
PRIVACY_URL=
# Absolute HTTPS origin that serves /uploads (needed for student photos in emails)
PUBLIC_BASE_URL=
# Photos are only included when this is true AND the photo has an HTTPS URL
EMAIL_INCLUDE_STUDENT_PHOTO=false

# Gate scanner: ignore a repeat scan of the same student within N seconds (0 disables)
SCAN_DEDUPE_SECONDS=5
