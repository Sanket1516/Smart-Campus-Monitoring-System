# Shared with the Node backend (SIDECAR_SECRET there). Min 24 chars.
SIDECAR_SECRET=
# Private interface only.
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8770
# Terminal VLAN ranges the sidecar may connect to (required).
SIDECAR_TERMINAL_CIDRS=10.20.0.0/16
# Comm key set on every terminal (ZK "password"); per-IP overrides as JSON. Never logged.
ZK_COMM_KEY=0
ZK_COMM_KEYS=
ZK_PORT=4370
ZK_TIMEOUT=15
ZK_FORCE_UDP=false
# Simultaneous TCP sessions across all terminals (X990 per-device limit UNVERIFIED).
SIDECAR_MAX_SESSIONS=2
SIDECAR_LOCK_WAIT=120
# pyzk enroll_user is UNVERIFIED on X990/ZK8; off by default.
SIDECAR_ENROLL_ENABLED=false
SIDECAR_BACKUP_DIR=./backups
# 64 hex chars: backups are AES-256-GCM encrypted when set (strongly recommended).
SIDECAR_BACKUP_KEY=
